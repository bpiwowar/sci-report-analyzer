msgstr "Ajouter"

msgid "Add & search sources"
msgstr "Ajouter et chercher les sources"

msgid "Add a PhD student"
msgstr "Ajouter un doctorant"

msgid "Add a conference"
msgstr "Ajouter une conférence"

msgid "Add a document (PDF) within the folder; or drop PDFs on this bar"
msgstr ""
"Ajouter un document (PDF) dans le dossier ; ou déposez des PDF sur cette "
"barre"

