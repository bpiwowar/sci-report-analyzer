msgstr "Ajouter un dossier dans celui-ci"

msgid "Add a former name"
msgstr "Ajouter un ancien nom"

msgid "Add a level"
msgstr "Ajouter un niveau"

msgid "Add a list"
msgstr "Ajouter une liste"

msgid "Add a main conference"
msgstr "Ajouter une conférence principale"

