msgstr "([lien]({url}))"

msgid "(automatic)"
msgstr "(automatique)"

msgid "(choose a period for a tag within a period, e.g. starred)"
msgstr ""
"(choisissez une période pour une étiquette propre à la période, p. ex. "
"starred)"

