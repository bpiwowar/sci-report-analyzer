msgstr "Ajouter une personne"

#, python-brace-format
msgid "Add a person to “{folder}”"
msgstr "Ajouter une personne à « {folder} »"

msgid "Add a profile by URL or id"
msgstr "Ajouter un profil par URL ou identifiant"

msgid "Add a publication"
msgstr "Ajouter une publication"

msgid "Add a publication by hand (DOI or HAL id)"
msgstr "Ajouter une publication à la main (DOI ou identifiant HAL)"

msgid "Add a role"
msgstr "Ajouter un rôle"

msgid "Add a rule"
msgstr "Ajouter une règle"

