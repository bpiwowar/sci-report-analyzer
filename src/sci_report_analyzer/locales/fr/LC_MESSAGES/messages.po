"Add the selected text (or the highlight clicked) to a category of "
"{folder} (E)"
msgstr ""
"Ajouter le texte sélectionné (ou le surlignage cliqué) à une catégorie de"
" {folder} (E)"

msgid "Add the ticked ones"
msgstr "Ajouter celles cochées"

